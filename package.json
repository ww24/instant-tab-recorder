{
  "name": "instant-tab-recorder",
  "version": "1.8.0",
  "type": "module",
  "description": "Google Chrome Extensions Screen Recorder",
  "scripts": {
    "build": "SOURCEMAP=1 vite build",
    "build:prod": "rm -f extension.zip && ENV_NAME=production vite build && zip -r extension.zip extension",
    "watch": "vite build --watch --mode development",
    "lint": "oxlint docs scripts src tests *.ts",
    "lint:fix": "npm run lint -- --fix",
    "lint:ts": "npx tsc --noEmit --skipLibCheck",
    "fmt": "oxfmt docs scripts src tests *.ts",
    "fmt:check": "npm run fmt -- --check",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser*",
    "test:all": "vitest run",
    "test:coverage": "npm run test:all -- --coverage",
    "site": "vite dev --config docs/vite.config.ts",
    "site:build": "vite build --config docs/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ww24/instant-tab-recorder.git"
  },
  "homepage": "https://recorder.appcloud.info/",
  "author": "ww24",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@material/web": "^2.5.0",
    "@mediabunny/flac-encoder": "1.56.3",
    "@sentry/browser": "^10.74.0",
    "lit": "^3.3.3",
    "marked": "^18.0.13",
    "mediabunny": "1.56.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@googleapis/chromewebstore": "^5.0.0",
    "@types/chrome": "^0.2.9",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^26.6.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "google-auth-library": "^11.1.0",
    "marked": "^18.0.13",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vitest-browser-lit": "^1.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
